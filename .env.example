# 可选：首次启动时，如果没有 profiles.json，系统会用这些值初始化 default 环境。
# 推荐后续直接在页面“环境配置”里维护。
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=admin
SSH_PASSWORD=your_password
REMOTE_DIR=/opt/upload
SCRIPT_NAME=224.sh
DEFAULT_LOCAL_DIR=
# 仅供 db_pmigrel00ldb_88.sql 和 db_pmigrel00ldb_98.sql 使用。
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
LOG_DIR=runtime_logs
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=5
